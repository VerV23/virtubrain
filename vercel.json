{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "redirects": [
    { "source": "/solutions/:path*", "destination": "/business/", "permanent": true },
    { "source": "/services/:path*", "destination": "/enterprise/", "permanent": true },
    { "source": "/blog/:path*", "destination": "/verantis/#insights", "permanent": true },
    { "source": "/about", "destination": "/verantis/", "permanent": true },
    { "source": "/practice(.html)?", "destination": "/verantis/", "permanent": true },
    { "source": "/explore(.html)?", "destination": "/app/", "permanent": true },
    { "source": "/platform(.html)?", "destination": "/app/", "permanent": true },
    { "source": "/pain-points(.html)?", "destination": "/app/#view=pain", "permanent": true },
    { "source": "/approach(.html)?", "destination": "/enterprise/#approach", "permanent": true }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=2592000" }] }
  ]
}
